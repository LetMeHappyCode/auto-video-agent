{
  "source_srt": "E:\\aiCode\\claudeTextToPrompt\\文案分镜库\\寿命倒计时者的一生\\shots.json.build\\segment-0003.srt",
  "total_cues": 45,
  "total_shots": 17,
  "shots": [
    {
      "id": 1,
      "start": "00:02:17,200",
      "end": "00:02:20,000",
      "text": "二十六岁那年，你甩掉了谈了四年的女朋友。",
      "source_srt_ids": [91, 92]
    },
    {
      "id": 2,
      "start": "00:02:20,160",
      "end": "00:02:24,000",
      "text": "分手理由你记得一清二楚。你说对不起，我时间不多了。",
      "source_srt_ids": [93, 94, 95]
    },
    {
      "id": 3,
      "start": "00:02:24,160",
      "end": "00:02:26,880",
      "text": "他愣在原地，你转身就走，头也没回。",
      "source_srt_ids": [96, 97, 98]
    },
    {
      "id": 4,
      "start": "00:02:27,040",
      "end": "00:02:30,000",
      "text": "你算过，这段感情让你亏损一年两个月。",
      "source_srt_ids": [99, 100]
    },
    {
      "id": 5,
      "start": "00:02:30,240",
      "end": "00:02:33,520",
      "text": "你很满意，这是你第一次把感情折算成数字。",
      "source_srt_ids": [101, 102]
    },
    {
      "id": 6,
      "start": "00:02:33,680",
      "end": "00:02:40,160",
      "text": "三十八岁那年，你的人生已经彻底被数字接管。你的剩余时间三十四年三个月十四天。",
      "source_srt_ids": [103, 104, 105]
    },
    {
      "id": 7,
      "start": "00:02:40,320",
      "end": "00:02:43,520",
      "text": "你不敢生孩子，你怕你的数字不够陪他长大。",
      "source_srt_ids": [106, 107]
    },
    {
      "id": 8,
      "start": "00:02:43,680",
      "end": "00:02:48,240",
      "text": "你拒绝了升职，那个岗位每天要多耗三小时。你算了算，不值。",
      "source_srt_ids": [108, 109, 110, 111]
    },
    {
      "id": 9,
      "start": "00:02:48,400",
      "end": "00:02:53,840",
      "text": "你把父母接到身边，因为三年前你就发现，他们的倒计时只剩三年两个月。",
      "source_srt_ids": [112, 113, 114]
    },
    {
      "id": 10,
      "start": "00:02:54,000",
      "end": "00:02:56,720",
      "text": "你活得像个闹钟，每天盯着那两个数字。",
      "source_srt_ids": [115, 116]
    },
    {
      "id": 11,
      "start": "00:02:56,800",
      "end": "00:03:00,960",
      "text": "母亲走的那天，倒计时归零前十七秒，他忽然握住你的手，",
      "source_srt_ids": [117, 118, 119]
    },
    {
      "id": 12,
      "start": "00:03:01,040",
      "end": "00:03:03,840",
      "text": "问，儿子，你头顶那个数字到底是多少？",
      "source_srt_ids": [120, 121, 122]
    },
    {
      "id": 13,
      "start": "00:03:03,935",
      "end": "00:03:06,975",
      "text": "你愣住了，六十五年来，你从没告诉过任何人。",
      "source_srt_ids": [123, 124, 125]
    },
    {
      "id": 14,
      "start": "00:03:07,135",
      "end": "00:03:09,375",
      "text": "你说，妈，还有很多，你放心，",
      "source_srt_ids": [126, 127, 128, 129]
    },
    {
      "id": 15,
      "start": "00:03:09,535",
      "end": "00:03:11,935",
      "text": "这是你这一辈子第一次对数字说谎。",
      "source_srt_ids": [130]
    },
    {
      "id": 16,
      "start": "00:03:12,095",
      "end": "00:03:15,935",
      "text": "父亲走后，你坐在空荡荡的客厅里，忽然不知道该盯谁了。",
      "source_srt_ids": [131, 132, 133]
    },
    {
      "id": 17,
      "start": "00:03:16,015",
      "end": "00:03:19,695",
      "text": "你第一次觉得数字少了一个，你的世界就塌了一块。",
      "source_srt_ids": [134, 135]
    }
  ]
}

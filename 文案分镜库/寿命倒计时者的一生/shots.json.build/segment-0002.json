{
  "source_srt": "E:\\aiCode\\claudeTextToPrompt\\文案分镜库\\寿命倒计时者的一生\\shots.json.build\\segment-0002.srt",
  "total_cues": 42,
  "total_shots": 12,
  "shots": [
    {
      "id": 1,
      "start": "00:01:11,920",
      "end": "00:01:16,320",
      "text": "十四岁那年，你能一眼看穿任何人的死期，精确到秒。",
      "source_srt_ids": [49, 50, 51]
    },
    {
      "id": 2,
      "start": "00:01:16,400",
      "end": "00:01:22,640",
      "text": "你成了班里的半仙，同学们排着队请你算命，你只要扫一眼就能报出他们头顶的年限。",
      "source_srt_ids": [52, 53, 54]
    },
    {
      "id": 3,
      "start": "00:01:22,800",
      "end": "00:01:29,120",
      "text": "你从不说真话，你只说长命百岁，因为没人愿意听真话，就像没人愿意看见倒计时。",
      "source_srt_ids": [55, 56, 57, 58]
    },
    {
      "id": 4,
      "start": "00:01:29,280",
      "end": "00:01:33,840",
      "text": "你偷偷发现，隔壁那个天天抽烟的邻居只剩九天四小时。",
      "source_srt_ids": [59, 60]
    },
    {
      "id": 5,
      "start": "00:01:34,000",
      "end": "00:01:38,160",
      "text": "第九天凌晨一点，你听见了救护车的声音，由远及近。",
      "source_srt_ids": [61, 62, 63]
    },
    {
      "id": 6,
      "start": "00:01:38,240",
      "end": "00:01:40,160",
      "text": "你缩在被子里，浑身发抖。",
      "source_srt_ids": [64, 65]
    },
    {
      "id": 7,
      "start": "00:01:40,240",
      "end": "00:01:44,320",
      "text": "你第一次意识到，你能看见的从来不是数字，是结局。",
      "source_srt_ids": [66, 67, 68]
    },
    {
      "id": 8,
      "start": "00:01:44,560",
      "end": "00:01:50,560",
      "text": "你二十五岁那年，决定不当普通人了。你的数字显示，你还有四十七年三个月十四天。",
      "source_srt_ids": [69, 70, 71, 72]
    },
    {
      "id": 9,
      "start": "00:01:50,720",
      "end": "00:01:56,480",
      "text": "你把四十七年换算成秒，十四亿九千万秒，每一秒都在流走。你开始给人生标价。",
      "source_srt_ids": [73, 74, 75, 76]
    },
    {
      "id": 10,
      "start": "00:01:56,560",
      "end": "00:02:04,160",
      "text": "睡觉八小时浪费，砍到五小时。恋爱高风险投资，可能亏损三年。放弃朋友聚会，沉默成本。",
      "source_srt_ids": [77, 78, 79, 80, 81, 82]
    },
    {
      "id": 11,
      "start": "00:02:04,240",
      "end": "00:02:10,400",
      "text": "你退出了所有群。你把手机屏保换成倒计时。每天睁眼第一件事就是看它又少了多少。",
      "source_srt_ids": [83, 84, 85]
    },
    {
      "id": 12,
      "start": "00:02:10,480",
      "end": "00:02:17,120",
      "text": "你建了一张时间预算表，精确到分钟。通勤四十分钟，听课吃饭十五分钟，发呆不允许。",
      "source_srt_ids": [86, 87, 88, 89, 90]
    }
  ]
}

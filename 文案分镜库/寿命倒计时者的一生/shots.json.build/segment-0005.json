{
  "source_srt": "E:\\aiCode\\claudeTextToPrompt\\文案分镜库\\寿命倒计时者的一生\\shots.json.build\\segment-0005.srt",
  "total_cues": 38,
  "total_shots": 14,
  "shots": [
    {
      "id": 1,
      "start": "00:04:04,735",
      "end": "00:04:07,215",
      "text": "六十岁那年，你登上了人生的巅峰。",
      "source_srt_ids": [167, 168]
    },
    {
      "id": 2,
      "start": "00:04:07,295",
      "end": "00:04:14,255",
      "text": "你的剩余时间十二年三个月十四天，你把它拆成四千四百八十五个昼夜，一天都不允许浪费。",
      "source_srt_ids": [169, 170, 171]
    },
    {
      "id": 3,
      "start": "00:04:14,335",
      "end": "00:04:21,695",
      "text": "六十一岁学潜水，六十三岁学滑雪，六十五岁去看极光，六十八岁写回忆录，七十一岁办画展。",
      "source_srt_ids": [172, 173, 174, 175, 176]
    },
    {
      "id": 4,
      "start": "00:04:21,775",
      "end": "00:04:23,615",
      "text": "你提前预定了自己的终点。",
      "source_srt_ids": [177]
    },
    {
      "id": 5,
      "start": "00:04:23,775",
      "end": "00:04:28,815",
      "text": "七十二岁三个月十四天凌晨四点零四分四十七秒，",
      "source_srt_ids": [178]
    },
    {
      "id": 6,
      "start": "00:04:28,895",
      "end": "00:04:32,015",
      "text": "你把日子过成一张时刻表，精确到每一分钟。",
      "source_srt_ids": [179, 180]
    },
    {
      "id": 7,
      "start": "00:04:32,175",
      "end": "00:04:36,895",
      "text": "你成了所有人眼里的时间神明，一个知道结局还敢朝他走过去的人。",
      "source_srt_ids": [181, 182]
    },
    {
      "id": 8,
      "start": "00:04:37,055",
      "end": "00:04:41,455",
      "text": "那些看不见数字的人仰望你，说你是把人生过到极致的狠人。",
      "source_srt_ids": [183, 184]
    },
    {
      "id": 9,
      "start": "00:04:41,615",
      "end": "00:04:43,535",
      "text": "你微笑着点头，只有你知道。",
      "source_srt_ids": [185, 186]
    },
    {
      "id": 10,
      "start": "00:04:43,695",
      "end": "00:04:47,775",
      "text": "六十岁那年的每一个深夜，你都坐在阳台上盯着那行数字发呆。",
      "source_srt_ids": [187, 188]
    },
    {
      "id": 11,
      "start": "00:04:47,935",
      "end": "00:04:52,015",
      "text": "你安排好了四千四百八十五天，却没有一天是为想安排的。",
      "source_srt_ids": [189, 190]
    },
    {
      "id": 12,
      "start": "00:04:52,095",
      "end": "00:04:58,495",
      "text": "你列了半辈子清单，第一次发现清单上的每一件事都是为了不浪费，而不是因为你想做。",
      "source_srt_ids": [191, 192, 193]
    },
    {
      "id": 13,
      "start": "00:04:58,655",
      "end": "00:05:04,175",
      "text": "七十二岁凌晨四点零二分，你躺在这张陌生的床上，你还有两分四十七秒。",
      "source_srt_ids": [194, 195, 196]
    },
    {
      "id": 14,
      "start": "00:05:04,255",
      "end": "00:05:15,215",
      "text": "你忽然开始嫉妒那些看不见数字的人，他们不知道终点在哪儿，所以每一天都是惊喜。他们敢爱，敢赌，敢把一辈子压在一个不确定的人身上。他们无知，但他们完整。",
      "source_srt_ids": [197, 198, 199, 200, 201, 202, 203, 204]
    }
  ]
}

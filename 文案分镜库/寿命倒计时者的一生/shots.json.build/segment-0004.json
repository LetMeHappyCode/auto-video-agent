{
  "source_srt": "segment-0004.srt",
  "total_cues": 31,
  "total_shots": 11,
  "shots": [
    {
      "id": 1,
      "start": "00:03:19,935",
      "end": "00:03:20,895",
      "text": "四十五岁那年，",
      "source_srt_ids": [136]
    },
    {
      "id": 2,
      "start": "00:03:21,135",
      "end": "00:03:23,375",
      "text": "你成了时间医生，不是医院里那种，",
      "source_srt_ids": [137, 138]
    },
    {
      "id": 3,
      "start": "00:03:23,535",
      "end": "00:03:25,935",
      "text": "是有钱人圈子里口口相传的那种。",
      "source_srt_ids": [139]
    },
    {
      "id": 4,
      "start": "00:03:26,095",
      "end": "00:03:28,735",
      "text": "三千块一次，报出你还能活多久。",
      "source_srt_ids": [140, 141]
    },
    {
      "id": 5,
      "start": "00:03:28,895",
      "end": "00:03:33,375",
      "text": "你坐在高档会所的包间里，对面的人伸出手，你扫一眼，报出数字。",
      "source_srt_ids": [142, 143, 144, 145]
    },
    {
      "id": 6,
      "start": "00:03:33,535",
      "end": "00:03:37,535",
      "text": "有人听完嚎啕大哭，有人当场加价，求你说错一次。",
      "source_srt_ids": [146, 147, 148]
    },
    {
      "id": 7,
      "start": "00:03:37,695",
      "end": "00:03:39,775",
      "text": "你从不说错，你从没说错过。",
      "source_srt_ids": [149, 150]
    },
    {
      "id": 8,
      "start": "00:03:39,935",
      "end": "00:03:46,095",
      "text": "你一年接诊四百个问时间的人，你见过最长的一百一十七年，最短的四十一天。",
      "source_srt_ids": [151, 152, 153]
    },
    {
      "id": 9,
      "start": "00:03:46,255",
      "end": "00:03:51,215",
      "text": "你开始麻木，你发现人只是数字的容器，数字才是一切的真相。",
      "source_srt_ids": [154, 155, 156]
    },
    {
      "id": 10,
      "start": "00:03:51,375",
      "end": "00:03:57,055",
      "text": "四十七岁那年，有个老板跪在你面前，求你告诉他，他的情人能不能比他老婆死的早。",
      "source_srt_ids": [157, 158, 159, 160]
    },
    {
      "id": 11,
      "start": "00:03:57,055",
      "end": "00:04:04,495",
      "text": "你看了他一眼，报完数字起身就走。你走出门，在洗手间里吐了。你第一次觉得自己不是医生，是个报丧的。",
      "source_srt_ids": [161, 162, 163, 164, 165, 166]
    }
  ]
}

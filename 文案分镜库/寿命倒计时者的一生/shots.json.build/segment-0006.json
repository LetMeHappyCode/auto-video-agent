{
  "source_srt": "E:/aiCode/claudeTextToPrompt/文案分镜库/寿命倒计时者的一生/shots.json.build/segment-0006.srt",
  "total_cues": 21,
  "total_shots": 9,
  "shots": [
    {
      "id": 1,
      "start": "00:05:15,375",
      "end": "00:05:18,655",
      "text": "而你聪明了一辈子，算了一辈子，赢了一辈子。",
      "source_srt_ids": [205, 206, 207]
    },
    {
      "id": 2,
      "start": "00:05:18,735",
      "end": "00:05:21,775",
      "text": "你赢过了所有人，却从来没有赢过那个数字。",
      "source_srt_ids": [208, 209]
    },
    {
      "id": 3,
      "start": "00:05:21,855",
      "end": "00:05:29,375",
      "text": "你盯了他六十五年，看着他从六十五年三个月十四天七小时四十二分一路减到两分四十七秒。",
      "source_srt_ids": [210, 211]
    },
    {
      "id": 4,
      "start": "00:05:29,455",
      "end": "00:05:35,375",
      "text": "你忽然想起七岁那年那个阳光斜切的下午，你趴在桌上看着那行淡蓝色的字，",
      "source_srt_ids": [212, 213]
    },
    {
      "id": 5,
      "start": "00:05:35,455",
      "end": "00:05:37,935",
      "text": "心想这是什么？我是不是中奖了？",
      "source_srt_ids": [214, 215]
    },
    {
      "id": 6,
      "start": "00:05:38,015",
      "end": "00:05:42,495",
      "text": "零点零分零秒，数字归零的那一刻，窗外的天刚好亮了。",
      "source_srt_ids": [216, 217, 218]
    },
    {
      "id": 7,
      "start": "00:05:42,655",
      "end": "00:05:45,215",
      "text": "你没有恐惧，只觉得前所未有的轻。",
      "source_srt_ids": [219, 220]
    },
    {
      "id": 8,
      "start": "00:05:45,455",
      "end": "00:05:52,495",
      "text": "你花了一辈子才想明白一件事，倒计时从没有让你活得更久，他只是让你死得更具体。",
      "source_srt_ids": [221, 222, 223]
    },
    {
      "id": 9,
      "start": "00:05:52,575",
      "end": "00:05:59,615",
      "text": "而人生从来不是那行数字，是你七岁那年第一次看见他时好奇的眨下的那一下眼睛。",
      "source_srt_ids": [224, 225]
    }
  ]
}

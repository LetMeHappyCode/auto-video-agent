{
  "source_srt": "E:\\aiCode\\claudeTextToPrompt\\文案分镜库\\寿命倒计时者的一生\\shots.json.build\\segment-0001.srt",
  "total_cues": 48,
  "total_shots": 20,
  "shots": [
    {
      "id": 1,
      "start": "00:00:00,080",
      "end": "00:00:03,680",
      "text": "今天体验的人生副本是寿命倒计时者的一生。",
      "source_srt_ids": [1]
    },
    {
      "id": 2,
      "start": "00:00:03,840",
      "end": "00:00:06,960",
      "text": "凌晨四点零二分，你在陌生的房间里醒来，",
      "source_srt_ids": [2, 3]
    },
    {
      "id": 3,
      "start": "00:00:07,120",
      "end": "00:00:09,200",
      "text": "窗外是整座熟睡的城市，",
      "source_srt_ids": [4]
    },
    {
      "id": 4,
      "start": "00:00:09,360",
      "end": "00:00:13,120",
      "text": "眼前悬浮着一行淡蓝色的数字，像游戏里的血条，",
      "source_srt_ids": [5, 6]
    },
    {
      "id": 5,
      "start": "00:00:13,200",
      "end": "00:00:14,880",
      "text": "在黑暗中安静的跳动。",
      "source_srt_ids": [7]
    },
    {
      "id": 6,
      "start": "00:00:15,040",
      "end": "00:00:18,640",
      "text": "零小时两分钟四十七秒，你还有两分四十七秒。",
      "source_srt_ids": [8, 9]
    },
    {
      "id": 7,
      "start": "00:00:18,800",
      "end": "00:00:22,960",
      "text": "你听见自己的心跳和那串数字跳动的频率完全同步，",
      "source_srt_ids": [10]
    },
    {
      "id": 8,
      "start": "00:00:23,040",
      "end": "00:00:26,400",
      "text": "你没有慌，你这一辈子都在跟他对视，早就习惯了。",
      "source_srt_ids": [11, 12, 13]
    },
    {
      "id": 9,
      "start": "00:00:26,480",
      "end": "00:00:30,720",
      "text": "你忽然想起，你第一次看见他是在七岁零三个月的那个下午。",
      "source_srt_ids": [14, 15]
    },
    {
      "id": 10,
      "start": "00:00:30,800",
      "end": "00:00:34,960",
      "text": "那天下午两点，阳光斜着切进教室，灰尘在光柱里打转。",
      "source_srt_ids": [16, 17, 18]
    },
    {
      "id": 11,
      "start": "00:00:35,120",
      "end": "00:00:39,040",
      "text": "你低头写作业，眼前忽然多了一行淡蓝色的水字，擦不掉。",
      "source_srt_ids": [19, 20, 21]
    },
    {
      "id": 12,
      "start": "00:00:39,120",
      "end": "00:00:42,320",
      "text": "六十五年三个月十四天七小时四十二分。",
      "source_srt_ids": [22]
    },
    {
      "id": 13,
      "start": "00:00:42,400",
      "end": "00:00:44,400",
      "text": "你抬头，同桌头顶也有一行。",
      "source_srt_ids": [23, 24]
    },
    {
      "id": 14,
      "start": "00:00:44,480",
      "end": "00:00:45,600",
      "text": "七十五年两个月。",
      "source_srt_ids": [25]
    },
    {
      "id": 15,
      "start": "00:00:45,760",
      "end": "00:00:50,080",
      "text": "你回头，全班四十二个人，四十二个数字，像一排整齐的墓碑。",
      "source_srt_ids": [26, 27, 28, 29]
    },
    {
      "id": 16,
      "start": "00:00:50,160",
      "end": "00:00:53,760",
      "text": "你举手告诉老师，老师摸了摸你的额头，说你中暑了。",
      "source_srt_ids": [30, 31, 32]
    },
    {
      "id": 17,
      "start": "00:00:53,840",
      "end": "00:00:58,960",
      "text": "你回家告诉妈妈，她头顶的数字闪了闪，笑着说，小孩子家家的，净说胡话。",
      "source_srt_ids": [33, 34, 35, 36, 37]
    },
    {
      "id": 18,
      "start": "00:00:59,120",
      "end": "00:01:02,320",
      "text": "你急了，你大喊，妈妈，你还有四十二年八个月。",
      "source_srt_ids": [38, 39, 40, 41]
    },
    {
      "id": 19,
      "start": "00:01:02,480",
      "end": "00:01:07,200",
      "text": "那天晚上，你第一次挨了打。你终于明白，不是所有人都能看见那个数字。",
      "source_srt_ids": [42, 43, 44, 45]
    },
    {
      "id": 20,
      "start": "00:01:07,360",
      "end": "00:01:11,760",
      "text": "七十多亿人里，只有你一个人看得见那行数字。你开始利用他。",
      "source_srt_ids": [46, 47, 48]
    }
  ]
}

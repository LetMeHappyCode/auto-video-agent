{
  "source_srt": "今天体验的人生副本事,从小到大都是万人迷的帅哥.srt",
  "total_cues": 60,
  "total_shots": 21,
  "shots": [
    {
      "id": 1,
      "start": "00:00:00,100",
      "end": "00:00:03,933",
      "text": "今天体验的人生副本 是从小到大都是万人迷的帅哥",
      "source_srt_ids": [1, 2]
    },
    {
      "id": 2,
      "start": "00:00:03,933",
      "end": "00:00:06,266",
      "text": "你是被带入还是陷入了回忆呢",
      "source_srt_ids": [3]
    },
    {
      "id": 3,
      "start": "00:00:06,266",
      "end": "00:00:08,500",
      "text": "你的抽屉里永远有吃不完的零食",
      "source_srt_ids": [4]
    },
    {
      "id": 4,
      "start": "00:00:08,500",
      "end": "00:00:14,033",
      "text": "那是小学三年级 你还不懂得什么叫面容交好 你只知道前排扎马尾的女生",
      "source_srt_ids": [5, 6, 7]
    },
    {
      "id": 5,
      "start": "00:00:14,033",
      "end": "00:00:19,000",
      "text": "每天早上 都会偷偷往你的课桌里 塞一颗大白兔奶糖 你没有主动要过",
      "source_srt_ids": [8, 9, 10, 11]
    },
    {
      "id": 6,
      "start": "00:00:19,000",
      "end": "00:00:23,200",
      "text": "发作业本时 班主任总是习惯性的 把最轻松的那一缕递给你",
      "source_srt_ids": [12, 13, 14]
    },
    {
      "id": 7,
      "start": "00:00:23,200",
      "end": "00:00:29,533",
      "text": "当你偶尔忘记带家庭作业 他只会用手指轻轻点下你的额头 语气温柔的叹气 让你明天补上",
      "source_srt_ids": [15, 16, 17, 18]
    },
    {
      "id": 8,
      "start": "00:00:29,533",
      "end": "00:00:32,300",
      "text": "而旁边的男生 因为同样的原因正被罚站",
      "source_srt_ids": [19, 20]
    },
    {
      "id": 9,
      "start": "00:00:32,300",
      "end": "00:00:35,533",
      "text": "你不懂为什么 但你的身体已经提前学会了应对机制",
      "source_srt_ids": [21, 22]
    },
    {
      "id": 10,
      "start": "00:00:35,533",
      "end": "00:00:42,066",
      "text": "只要稍微低下头 用浓密的睫毛半遮住眼睛 再怯生生的抬眼看大人 所有的责罚都会化解",
      "source_srt_ids": [23, 24, 25, 26]
    },
    {
      "id": 11,
      "start": "00:00:42,066",
      "end": "00:00:46,633",
      "text": "这是一把没有形状的钥匙 你生来就握在手里 轻轻一推 门就开了",
      "source_srt_ids": [27, 28, 29, 30]
    },
    {
      "id": 12,
      "start": "00:00:46,633",
      "end": "00:00:49,266",
      "text": "初二的夏天 蝉鸣声吵得让人心慌",
      "source_srt_ids": [31, 32]
    },
    {
      "id": 13,
      "start": "00:00:49,266",
      "end": "00:00:53,900",
      "text": "你打完篮球出了一身汗 走到小卖部冰柜前 拿了一瓶冰镇运动饮料",
      "source_srt_ids": [33, 34, 35]
    },
    {
      "id": 14,
      "start": "00:00:53,900",
      "end": "00:00:57,033",
      "text": "摸遍口袋才发现没带钱 你尴尬的站在原地",
      "source_srt_ids": [36, 37]
    },
    {
      "id": 15,
      "start": "00:00:57,033",
      "end": "00:01:00,366",
      "text": "守在柜台的高三学姐看着你 没要你把饮料放回去",
      "source_srt_ids": [38, 39]
    },
    {
      "id": 16,
      "start": "00:01:00,366",
      "end": "00:01:04,333",
      "text": "而是把几枚硬币丢进收银机 对你眨了眨眼 下次再给",
      "source_srt_ids": [40, 41, 42]
    },
    {
      "id": 17,
      "start": "00:01:04,333",
      "end": "00:01:08,933",
      "text": "那一瞬间 胸口像是有微弱的电流穿过手指 指尖微微发麻",
      "source_srt_ids": [43, 44, 45]
    },
    {
      "id": 18,
      "start": "00:01:08,933",
      "end": "00:01:12,666",
      "text": "不是因为爱情 而是因为一种突如其来的 锋利的权利感",
      "source_srt_ids": [46, 47, 48]
    },
    {
      "id": 19,
      "start": "00:01:12,666",
      "end": "00:01:19,033",
      "text": "你发现哪怕什么都不做 只要站在这里 这副皮囊 就能自动为你兑换出 现实生活中的实质便利",
      "source_srt_ids": [49, 50, 51, 52, 53]
    },
    {
      "id": 20,
      "start": "00:01:19,033",
      "end": "00:01:22,433",
      "text": "那天下午 你第一次认真端详 洗手间 镜子里的自己",
      "source_srt_ids": [54, 55, 56, 57]
    },
    {
      "id": 21,
      "start": "00:01:22,433",
      "end": "00:01:27,200",
      "text": "高挺的鼻梁 深邃的眼窝 以及因为刚运动完而泛着红晕的皮肤",
      "source_srt_ids": [58, 59, 60]
    }
  ]
}

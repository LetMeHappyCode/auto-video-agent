{
  "source_srt": "字幕文案.srt",
  "total_cues": 35,
  "total_shots": 13,
  "shots": [
    {
      "id": 1,
      "start": "00:00:00,100",
      "end": "00:00:03,000",
      "text": "今天体验的人生 副本是长生者的一生",
      "source_srt_ids": [1, 2]
    },
    {
      "id": 2,
      "start": "00:00:03,066",
      "end": "00:00:07,166",
      "text": "睁开眼你的视网膜在1/10,000秒内 完成了对光线的捕捉",
      "source_srt_ids": [3, 4]
    },
    {
      "id": 3,
      "start": "00:00:07,266",
      "end": "00:00:12,733",
      "text": "将2026年5月28日的周遭景象以极其 锐利的清晰度呈现在大脑中",
      "source_srt_ids": [5, 6]
    },
    {
      "id": 4,
      "start": "00:00:12,733",
      "end": "00:00:19,100",
      "text": "你坐起身 听见自己胸腔里那颗 心脏发出沉稳强健 如同鼓钟撞击般的搏动声",
      "source_srt_ids": [7, 8, 9, 10]
    },
    {
      "id": 5,
      "start": "00:00:19,266",
      "end": "00:00:23,300",
      "text": "你抬起手 看着自己的掌纹 没有老年斑 没有干枯的褶皱",
      "source_srt_ids": [11, 12, 13, 14]
    },
    {
      "id": 6,
      "start": "00:00:23,300",
      "end": "00:00:25,933",
      "text": "你的生理机能完美的定格在26岁",
      "source_srt_ids": [15]
    },
    {
      "id": 7,
      "start": "00:00:25,933",
      "end": "00:00:30,933",
      "text": "但这具年轻的过分的躯壳里 却装载着一个被磨损 的千疮百孔的灵魂",
      "source_srt_ids": [16, 17, 18]
    },
    {
      "id": 8,
      "start": "00:00:30,933",
      "end": "00:00:36,133",
      "text": "你走到房间尽头的秘密暗室 打开那座三重密码锁 保护的钛合金防爆柜",
      "source_srt_ids": [19, 20, 21]
    },
    {
      "id": 9,
      "start": "00:00:36,166",
      "end": "00:00:41,466",
      "text": "里面没有金条 只有成百上千本用不同年代 的纸张拼凑起来的古籍日记",
      "source_srt_ids": [22, 23, 24]
    },
    {
      "id": 10,
      "start": "00:00:41,500",
      "end": "00:00:45,000",
      "text": "以及几千张散发着陈旧 气味的身份证件和度牒",
      "source_srt_ids": [25, 26]
    },
    {
      "id": 11,
      "start": "00:00:45,000",
      "end": "00:00:50,166",
      "text": "大汉的游侠 盛唐的诗人 大明的盐商 现代的弄潮儿",
      "source_srt_ids": [27, 28, 29, 30]
    },
    {
      "id": 12,
      "start": "00:00:50,166",
      "end": "00:00:53,766",
      "text": "这些档案里的人 全部长着和你一模一样的脸",
      "source_srt_ids": [31, 32]
    },
    {
      "id": 13,
      "start": "00:00:53,766",
      "end": "00:00:56,766",
      "text": "世人都在疯狂的烧香拜佛 炼丹寻药 将永生奉为至高无上的神技",
      "source_srt_ids": [33, 34, 35]
    }
  ]
}
